# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public URL of the app (used for password-recovery links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL · SERVER ONLY (never NEXT_PUBLIC_). Lets administrators create users
# and reset passwords from the Usuarios screen. Supabase → Project Settings →
# API Keys → secret (sb_secret_...) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
